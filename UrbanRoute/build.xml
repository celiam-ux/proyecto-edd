<?xml version="1.0" encoding="UTF-8"?>
<project name="UrbanRoute" default="default" basedir=".">
    <description>Construye, prueba y ejecuta UrbanRoute.</description>

    <property file="nbproject/project.properties"/>

    <target name="-init">
        <mkdir dir="${build.classes.dir}"/>
        <mkdir dir="${dist.dir}"/>
    </target>

    <target name="compile" depends="-init">
        <javac srcdir="${src.dir}"
               destdir="${build.classes.dir}"
               classpath="${javac.classpath}"
               release="${javac.release}"
               encoding="${source.encoding}"
               includeantruntime="false"
               debug="true"/>
    </target>

    <target name="jar" depends="compile">
        <jar destfile="${dist.jar}" manifest="manifest.mf">
            <fileset dir="${build.classes.dir}"/>
        </jar>
        <copy todir="${dist.dir}/lib">
            <fileset dir="lib" includes="*.jar,AVISO.md,LICENCIA-*.txt"/>
        </copy>
    </target>

    <target name="run" depends="jar">
        <java jar="${dist.jar}" fork="true"/>
    </target>

    <target name="test" depends="compile">
        <mkdir dir="${build.test.classes.dir}"/>
        <javac srcdir="${test.src.dir}"
               destdir="${build.test.classes.dir}"
               classpath="${javac.test.classpath}"
               release="${javac.release}"
               encoding="${source.encoding}"
               includeantruntime="false"
               debug="true"/>
        <java classname="EDD.PruebaLista" fork="true" failonerror="true">
            <classpath>
                <pathelement location="${build.classes.dir}"/>
                <pathelement location="${build.test.classes.dir}"/>
            </classpath>
        </java>
        <java classname="EDD.PruebaColas" fork="true" failonerror="true">
            <classpath>
                <pathelement location="${build.classes.dir}"/>
                <pathelement location="${build.test.classes.dir}"/>
            </classpath>
        </java>
        <java classname="Funciones.PruebaGestorArchivo" fork="true" failonerror="true">
            <classpath>
                <pathelement location="${build.classes.dir}"/>
                <pathelement location="${build.test.classes.dir}"/>
            </classpath>
        </java>
        <java classname="Funciones.PruebaSesionCsv" fork="true" failonerror="true">
            <classpath>
                <pathelement path="${javac.test.classpath}"/>
                <pathelement location="${build.test.classes.dir}"/>
            </classpath>
        </java>
    </target>

    <target name="clean">
        <delete dir="${build.dir}"/>
        <delete dir="${dist.dir}"/>
    </target>

    <target name="default" depends="clean,test,jar"/>
</project>
